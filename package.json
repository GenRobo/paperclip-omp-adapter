{
  "name": "@genrobo/paperclip-omp-adapter",
  "version": "0.9.0",
  "description": "External Paperclip adapter for the Oh My Pi coding-agent CLI",
  "type": "module",
  "license": "MIT",
  "author": "zhafron",
  "keywords": [
    "paperclip",
    "oh-my-pi",
    "omp",
    "adapter",
    "coding-agent",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GenRobo/paperclip-omp-adapter.git"
  },
  "homepage": "https://github.com/GenRobo/paperclip-omp-adapter#readme",
  "bugs": {
    "url": "https://github.com/GenRobo/paperclip-omp-adapter/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "paperclip": {
    "adapterUiParser": "1.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./ui-parser": "./dist/ui-parser.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node test/smoke.mjs && node --test test/mcp.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@paperclipai/adapter-utils": "2026.1012.0",
    "@paperclipai/shared": "2026.1012.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
